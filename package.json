{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "check:dead": "knip --include files,dependencies,unlisted,unresolved",
    "check:dead:exports": "knip --include exports,types",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm check:arch && pnpm check:dead && pnpm test:run"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "dependency-cruiser": "^18.9.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.0.1",
    "knip": "^6.48.0",
    "solid-devtools": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@solidjs/router": "^0.16.1",
    "@suid/icons-material": "^0.9.0",
    "@suid/material": "^0.19.0",
    "@supabase/supabase-js": "^2.105.3",
    "apexcharts": "^5.10.6",
    "solid-apexcharts": "^0.6.0",
    "solid-js": "^1.9.9",
    "solid-transition-group": "^0.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  }
}
